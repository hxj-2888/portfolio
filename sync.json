{
  "_说明": "项目同步配置 — 由 sync-projects.js 读取。enabled=false 的项目在同步时跳过并记录原因。",
  "_用法": "node sync-projects.js          # 执行同步（自动打内嵌适配补丁）",
  "_用法2": "node sync-projects.js --dry-run # 只预览，不写磁盘",
  "projects": [
    {
      "id": "delta-force",
      "enabled": true,
      "sourceDir": "../delta-force-deploy",
      "targetDir": "projects/delta-force",
      "note": "三角洲独立部署仓库 → 作品集副本。同步后自动打 portfolio 内嵌适配补丁",
      "files": [
        "index.html",
        "sw.js",
        "manifest.json",
        "js/bundle.js",
        "js/sw-register.js",
        "css/layout.css",
        "css/components.css",
        "data/metadata.json",
        "icon.ico",
        "icon-192.png",
        "icon-512.png",
        "icon-maskable-512.png",
        "delta-force-logo.webp"
      ],
      "neverCopy": {
        "_警告": "以下文件绝不可复制进 portfolio，否则会劫持作品集站点",
        "functions/index.js": "独立域名的根路径 302 缓存破除重定向，放进 portfolio 会劫持作品集首页",
        "functions/api/[[path]].js": "两边仅一行合法差异（metadata.json 静态回退路径各自适配所在域名），portfolio 侧已正确，保持各自维护"
      },
      "patches": [
        {
          "file": "index.html",
          "note": "根绝对路径改相对路径（内嵌预览时 /xxx 会指向作品集根目录而 404）",
          "rules": [
            {
              "type": "regex",
              "from": "href=\"/delta-force-logo\\.webp(\\?v=[a-z0-9-]+)?\"",
              "to": "href=\"delta-force-logo.webp$1\"",
              "okIfContains": "href=\"delta-force-logo.webp"
            },
            {
              "type": "string",
              "from": "href=\"/manifest.json\"",
              "to": "href=\"manifest.json\"",
              "okIfContains": "href=\"manifest.json\""
            },
            {
              "type": "regex",
              "from": "href=\"/icon\\.ico(\\?v=[a-z0-9-]+)?\"",
              "to": "href=\"icon.ico$1\"",
              "okIfContains": "href=\"icon.ico"
            },
            {
              "type": "regex",
              "from": "href=\"/icon-192\\.png(\\?v=[a-z0-9-]+)?\"",
              "to": "href=\"icon-192.png$1\"",
              "okIfContains": "href=\"icon-192.png"
            }
          ]
        },
        {
          "file": "js/sw-register.js",
          "note": "portfolio 专属适配：恢复 iframe 守卫 + SW 注册改相对路径并加 pf 后缀（换新缓存桶，防止老访客被旧桶缓存-first 卡住旧 logo/旧文案）",
          "rules": [
            {
              "type": "string",
              "from": "if (!('serviceWorker' in navigator)) return;",
              "to": "if (!('serviceWorker' in navigator)) return;\n  // portfolio 专属适配：嵌入 iframe 预览时不注册 SW，避免与作品集站点作用域冲突（勿删）\n  if (window.self !== window.top) return;",
              "okIfContains": "window.self !== window.top"
            },
            {
              "type": "regex",
              "from": "register\\('/sw\\.js\\?v=([^']+)'\\)",
              "to": "register('sw.js?v=$1pf', { scope: './' })",
              "okIfContains": "register('sw.js?v="
            }
          ]
        },
        {
          "file": "sw.js",
          "note": "portfolio 专属适配：HTML 与 data/ 判定改为按子路径匹配（内嵌副本位于 /projects/delta-force/ 子目录，原根路径判定会让 HTML/metadata 走缓存优先而陈旧）",
          "rules": [
            {
              "type": "string",
              "from": "if (url.pathname === '/' || url.pathname === '/index.html') {",
              "to": "if (url.pathname === '/' || url.pathname === '/index.html' || url.pathname.endsWith('/') || url.pathname.endsWith('/index.html')) { // portfolio 适配：子目录部署",
              "okIfContains": "url.pathname.endsWith('/index.html')"
            },
            {
              "type": "string",
              "from": "if (url.pathname.indexOf('/data/') === 0) {",
              "to": "if (url.pathname.indexOf('/data/') !== -1) { // portfolio 适配：子目录部署",
              "okIfContains": "url.pathname.indexOf('/data/') !== -1"
            }
          ]
        },
        {
          "file": "manifest.json",
          "note": "portfolio 专属适配：PWA 图标与 start_url/scope 改相对路径（根绝对路径在内嵌子目录下会指向作品集根而 404/越界）",
          "rules": [
            {
              "type": "string",
              "from": "\"src\": \"/icon-192.png?v=2\"",
              "to": "\"src\": \"icon-192.png?v=2\"",
              "okIfContains": "\"src\": \"icon-192.png?v=2\""
            },
            {
              "type": "string",
              "from": "\"src\": \"/icon-512.png?v=2\"",
              "to": "\"src\": \"icon-512.png?v=2\"",
              "okIfContains": "\"src\": \"icon-512.png?v=2\""
            },
            {
              "type": "string",
              "from": "\"src\": \"/icon-maskable-512.png?v=2\"",
              "to": "\"src\": \"icon-maskable-512.png?v=2\"",
              "okIfContains": "\"src\": \"icon-maskable-512.png?v=2\""
            },
            {
              "type": "string",
              "from": "\"start_url\": \"/\"",
              "to": "\"start_url\": \"./\"",
              "okIfContains": "\"start_url\": \"./\""
            },
            {
              "type": "string",
              "from": "\"scope\": \"/\"",
              "to": "\"scope\": \"./\"",
              "okIfContains": "\"scope\": \"./\""
            }
          ]
        }
      ]
    },
    {
      "id": "ping-pong-duel",
      "enabled": true,
      "sourceDir": "../乒乓对决_合并/public",
      "targetDir": "projects/ping-pong-duel",
      "note": "乒乓对决源仓库 public/（部署到 ping-pong-duel.pages.dev 的同一份产物）→ 作品集副本。已确认全部为相对路径、SW 作用域 ./ 不越界，无需补丁。_worker.js（房间服务，部署在独立 Pages 项目）与 APK（体积大，作品集不分发安装包）不复制",
      "files": [
        "index.html",
        "download.html",
        "sw.js",
        "manifest.webmanifest",
        "css/style.css",
        "js/ai.js",
        "js/audio.js",
        "js/characters.js",
        "js/engine.js",
        "js/network.js",
        "js/render.js",
        "js/app/dressup.js",
        "js/app/hud.js",
        "js/app/input.js",
        "js/app/loop.js",
        "js/app/main.js",
        "js/app/modes.js",
        "js/app/net.js",
        "js/app/records.js",
        "js/app/render.js",
        "js/app/replay.js",
        "js/app/state.js",
        "js/app/teams.js",
        "js/app/training.js",
        "js/engine/math.js",
        "js/engine/physics.js",
        "js/engine/rules.js",
        "js/engine/shots.js",
        "js/engine/state.js",
        "js/engine/strokes.js",
        "icon-192.png",
        "icon-512.png",
        "qr-download.png",
        "audio/applause.wav",
        "audio/music.mp4"
      ]
    },
    {
      "id": "portfolio-source",
      "enabled": false,
      "reason": "作品集自身源码展示页，无外部来源，直接在 projects/ 内维护"
    },
    {
      "id": "space-kill",
      "enabled": true,
      "sourceDir": "../space-kill-3.0/site",
      "targetDir": "projects/space-kill",
      "note": "太空杀官网部署源（space-kill.pages.dev 的同一份产物）→ 作品集副本。2026-08-30 起内嵌预览与官网完全一致，改为自动同步防止再次漂移（旧的 2.0/3.0/3.1 多版本门户已移除，其文档以 space-kill 仓库为准）",
      "files": [
        "index.html",
        "rules.html",
        "sim31-flows.html",
        "sim31-matrix.html",
        "story-human.html",
        "story-alien.html",
        "story-xeno.html"
      ]
    }
  ]
}
