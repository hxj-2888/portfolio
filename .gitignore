# 敏感文件 — 绝不上传
.env*
*.keystore
*.jks
*.pem
*.key
id_rsa*

# Cloudflare 本地缓存（含账号信息与调试数据，必须排除）
.wrangler/
.wrangler.dev/

# build-collect 克隆暂存目录
.collect-temp/

# Node
node_modules/
package-lock.json

# Python 缓存（.pyc 内含编译时本地路径，绝不入库）
__pycache__/
*.pyc

# 分发压缩包与安装包（本地打包产物，不入库；由本地 Pages 部署直发）
*.zip
*.apk
dist/

# 系统垃圾
.DS_Store
Thumbs.db
*.log
